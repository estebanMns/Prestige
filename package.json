{
  "name": "perfumeria-prestige",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda en línea de Perfumería Prestige: catálogo, asesor con IA, panel de administración con JWT y pedidos por WhatsApp.",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file=.env --import tsx db/migrate.ts",
    "db:migrate:prod": "node --env-file=.env.rds --import tsx db/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx db/seed.ts",
    "db:seed:prod": "node --env-file=.env.rds --import tsx db/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@aws-sdk/client-s3": "3.1100.0",
    "@aws-sdk/s3-request-presigner": "3.1100.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.3.0",
    "argon2": "0.44.0",
    "aws-sdk": "^2.1693.0",
    "jose": "6.1.3",
    "next": "15.5.28",
    "otplib": "12.0.1",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "three": "0.180.0",
    "zod": "4.1.13",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.180.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
